{
  "name": "@img2threejs/img2",
  "version": "0.3.0",
  "description": "Plugin harness for the img2 ecosystem: everything is a plugin.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "bin/img2.mjs",
  "bin": {
    "img2": "bin/img2.mjs",
    "create-img2-plugin-cli": "bin/create-plugin-cli.mjs"
  },
  "exports": {
    ".": "./bin/img2.mjs",
    "./plugin-cli": "./bin/plugin-cli.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "img2_core",
    "docs",
    "templates",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/.omc/**"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests/python -p 'test_*.py'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/img2threejs/img2.git"
  }
}